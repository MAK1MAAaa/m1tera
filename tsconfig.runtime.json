{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "dist-runtime",
    "sourceMap": true
  },
  "include": ["runtime/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "third_party", "**/*.test.ts"]
}
